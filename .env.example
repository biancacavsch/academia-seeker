# Job Pipeline - Environment Variables
# Copie para .env e preencha os valores

# Telegram Bot (opcional)
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Email SMTP (opcional - ex: Gmail com App Password)
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_app_password_aqui
FROM_EMAIL=seu_email@gmail.com
TO_EMAIL=destino@gmail.com

# Adzuna API (gratuito - 250 calls/dia)
# Registre em https://developer.adzuna.com/
ADZUNA_APP_ID=seu_app_id_aqui
ADZUNA_APP_KEY=sua_app_key_aqui

# Jooble API (gratuito - 60 países)
# Solicite chave em https://jooble.org/api/about
JOOBLE_API_KEY=sua_chave_aqui